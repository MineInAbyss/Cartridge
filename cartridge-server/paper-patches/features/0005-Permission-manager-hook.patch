+    // Cartridge start - Permission manager hook
+    private static PermissibleBase createPermissible(final CraftHumanEntity entity) {
+        final org.bukkit.permissions.Permissible permissible = org.bukkit.Bukkit.getPluginManager().createPermissible(entity);
+        final PermissibleBase base;
+        if (permissible instanceof final PermissibleBase permissibleBase) {
+            base = permissibleBase;
+        } else {
+            com.mojang.logging.LogUtils.getLogger().warn("Permission manager returned {} for {}, which is not a PermissibleBase, using the default one", permissible.getClass().getName(), entity.getName());
+            base = new PermissibleBase(entity);
+        }
+        ((CraftEntity) entity).perm = base;
+        return base;
+    }
+
+    @Override
+    protected org.bukkit.permissions.Permissible permissible() {
+        final PermissibleBase legacy = this.perm;
+        if (legacy != super.perm) {
+            if (WARNED_LEGACY_PERMISSIBLE.compareAndSet(false, true)) {
+                com.mojang.logging.LogUtils.getLogger().warn("A plugin replaced CraftHumanEntity#perm of {} by reflection, which is deprecated. Permission plugins should provide player permissibles through PermissionManager#createPermissible instead", this.getName());
+            }
+            super.perm = legacy;
+        }
+        return legacy;
+    }
+    // Cartridge end - Permission manager hook
