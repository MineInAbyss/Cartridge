From: Boy0000 <sivertpaulsen2@gmail.com>
Date: Thu, 22 Oct 2026 20:28:22 +0200
Subject: [PATCH] Tripwire inside event states


diff --git a/src/main/java/io/papermc/paper/configuration/GlobalConfiguration.java b/src/main/java/io/papermc/paper/configuration/GlobalConfiguration.java
index 014f8488af19ba4c95365d6867784e76406c9165..d68fde4f77a0432a2b36360ed12aa9ba276f83ed 100644
--- a/src/main/java/io/papermc/paper/configuration/GlobalConfiguration.java
+++ b/src/main/java/io/papermc/paper/configuration/GlobalConfiguration.java
@@ -349,8 +349,37 @@ public class GlobalConfiguration extends ConfigurationPart {
     public class BlockUpdates extends ConfigurationPart {
         public boolean disableNoteblockUpdates = false;
         public boolean disableTripwireUpdates = false;
+        // Cartridge start - tripwire states that fire EntityInsideBlockEvent
+        @Comment("Tripwire states that still fire EntityInsideBlockEvent while tripwire updates are disabled, written like minecraft:tripwire[attached=true,disarmed=false].\nProperties left out match any value. The tripwire itself stays unchanged")
+        public java.util.List<String> tripwireInsideEventStates = java.util.List.of();
+        private transient java.util.List<net.minecraft.commands.arguments.blocks.BlockStateParser.BlockResult> tripwireInsideEventMatchers = java.util.List.of();
+        // Cartridge end - tripwire states that fire EntityInsideBlockEvent
         public boolean disableChorusPlantUpdates = false;
         public boolean disableMushroomBlockUpdates = false;
+
+        // Cartridge start - tripwire states that fire EntityInsideBlockEvent
+        @PostProcess
+        private void parseTripwireInsideEventStates() {
+            final java.util.List<net.minecraft.commands.arguments.blocks.BlockStateParser.BlockResult> matchers = new java.util.ArrayList<>();
+            for (final String state : this.tripwireInsideEventStates) {
+                try {
+                    matchers.add(net.minecraft.commands.arguments.blocks.BlockStateParser.parseForBlock(net.minecraft.core.registries.BuiltInRegistries.BLOCK, state, false));
+                } catch (final com.mojang.brigadier.exceptions.CommandSyntaxException e) {
+                    LOGGER.error("Invalid block-updates.tripwire-inside-event-states entry '{}': {}", state, e.getMessage());
+                }
+            }
+            this.tripwireInsideEventMatchers = java.util.List.copyOf(matchers);
+        }
+
+        public boolean firesTripwireInsideEvent(final net.minecraft.world.level.block.state.BlockState state) {
+            for (final net.minecraft.commands.arguments.blocks.BlockStateParser.BlockResult matcher : this.tripwireInsideEventMatchers) {
+                if (state.is(matcher.blockState().getBlock()) && matcher.properties().entrySet().stream().allMatch(entry -> state.getValue(entry.getKey()).equals(entry.getValue()))) {
+                    return true;
+                }
+            }
+            return false;
+        }
+        // Cartridge end - tripwire states that fire EntityInsideBlockEvent
     }
 
     public Anticheat anticheat;
