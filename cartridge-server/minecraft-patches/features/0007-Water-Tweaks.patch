From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Boy0000 <sivertpaulsen2@gmail.com>
Date: Sun, 11 Oct 2026 15:41:49 +0200
Subject: [PATCH] Water Tweaks


diff --git a/net/minecraft/server/level/ServerPlayer.java b/net/minecraft/server/level/ServerPlayer.java
index 3a74e55053c4eae8d6534e4873667e18db624440..4c3ecad8a6316922f56ebce46839f6c9e3a97d43 100644
--- a/net/minecraft/server/level/ServerPlayer.java
+++ b/net/minecraft/server/level/ServerPlayer.java
@@ -479,6 +479,9 @@ public class ServerPlayer extends Player implements ca.spottedleaf.moonrise.patc
 
     // Cartridge start
     public volatile boolean hasClientSideClimbable = true; // volatile, written from the netty thread on tag sync
+    public int flowingWaterHurtCooldown = 0;
+    public double waterFallChainY = Double.NaN; // feet Y at the last water entry of the current fall chain, NaN outside a chain
+    public boolean safeFallDistanceSpent = false;
     // Cartridge end
 
     public ServerPlayer(final MinecraftServer server, final ServerLevel level, final GameProfile gameProfile, final ClientInformation clientInformation) {
@@ -774,6 +777,19 @@ public class ServerPlayer extends Player implements ca.spottedleaf.moonrise.patc
         }
 
         this.trackStartFallingPosition();
+        // Cartridge start - flowing water and bubble columns batter anyone swimming in them
+        if (this.flowingWaterHurtCooldown > 0) this.flowingWaterHurtCooldown--;
+        if (this.flowingWaterHurtCooldown <= 0 && this.isInHazardousWater()) {
+            DamageSource hazardSource = this.damageSources().generic();
+            if (this.hurtServer(this.level(), hazardSource, 4.0F)) {
+                // shove in a random horizontal direction so the current cannot be ridden calmly
+                double angle = this.random.nextDouble() * Math.PI * 2.0;
+                this.knockback(0.4, Math.cos(angle), Math.sin(angle), hazardSource, 4.0F, false);
+                this.markHurt();
+            }
+            this.flowingWaterHurtCooldown = 20;
+        }
+        // Cartridge end
         this.trackEnteredOrExitedLavaOnVehicle();
         this.updatePlayerAttributes();
         this.advancements.flushDirty(this, true);
@@ -1063,9 +1079,45 @@ public class ServerPlayer extends Player implements ca.spottedleaf.moonrise.patc
         }
 
         this.startingToFallPosition = null;
+        // Cartridge start
+        this.waterFallChainY = Double.NaN;
+        this.safeFallDistanceSpent = false;
+        // Cartridge end
         super.resetFallDistance();
     }
 
+    // Cartridge start
+    @Override
+    public int calculateFallDamage(final double fallDistance, final float damageModifier) {
+        double safeFallDistanceRefund = this.safeFallDistanceSpent ? this.getAttributeValue(Attributes.SAFE_FALL_DISTANCE) : 0.0;
+        return super.calculateFallDamage(fallDistance + safeFallDistanceRefund, damageModifier);
+    }
+
+    @Override
+    public void teleportSetPosition(final PositionMoveRotation currentValues, final PositionMoveRotation destination, final Set<Relative> relatives) {
+        double startY = this.getY();
+        super.teleportSetPosition(currentValues, destination, relatives);
+        // Teleports such as DeeperWorld section transitions keep the fall, so the chain's water entry height must move with the player
+        this.waterFallChainY += this.getY() - startY;
+    }
+
+    // Water only cushions a fall where it is at least two blocks deep at the feet.
+    // In thinner water the fall follows the net drop, so water and air stacks cost their full height while bobbing nets out
+    public void accumulateFallDistance(final double ya) {
+        BlockPos feet = this.blockPosition();
+        boolean cushioned = this.isInWater()
+            && this.level().getFluidState(feet).is(FluidTags.WATER)
+            && this.level().getFluidState(feet.below()).is(FluidTags.WATER);
+        if (cushioned) return;
+
+        if (ya < 0.0) {
+            this.fallDistance -= (float)ya;
+        } else if (this.isInWater()) {
+            this.fallDistance = Math.max(0.0, this.fallDistance - (float)ya);
+        }
+    }
+    // Cartridge end
+
     public void trackStartFallingPosition() {
         if (this.fallDistance > 0.0 && this.startingToFallPosition == null) {
             this.startingToFallPosition = this.position();
diff --git a/net/minecraft/world/entity/Entity.java b/net/minecraft/world/entity/Entity.java
index 9c48c8cc25fa27a4c8c518e7bd5775d1681b3b75..b9e32f410fe8639226d57bc0070abee08cd942d2 100644
--- a/net/minecraft/world/entity/Entity.java
+++ b/net/minecraft/world/entity/Entity.java
@@ -1222,7 +1222,7 @@ public abstract class Entity
                     BlockHitResult hitResult = this.level()
                         .clip(new ClipContext(this.position(), checkTo, ClipContext.Block.FALLDAMAGE_RESETTING, ClipContext.Fluid.WATER, this));
                     if (hitResult.getType() != HitResult.Type.MISS) {
-                        this.resetFallDistance();
+                        //this.resetFallDistance(); // Cartridge - Make water not negate falldamage
                     }
                 }
 
@@ -2114,7 +2114,7 @@ public abstract class Entity
     }
 
     protected void checkFallDamage(final double ya, final boolean onGround, final BlockState onState, final BlockPos pos) {
-        if (!this.isInWater() && ya < 0.0) {
+        if (!(this instanceof ServerPlayer) && !this.isInWater() && ya < 0.0) { // Cartridge - players accumulate in ServerPlayer.accumulateFallDistance
             this.fallDistance -= (float)ya;
         }
 
@@ -2178,6 +2178,14 @@ public abstract class Entity
         return this.fluidInteraction.isInFluid(FluidTags.ENTITY_FLOATABLE);
     }
 
+    // Cartridge start - flowing water (waterfalls etc) and bubble columns batter anyone swimming in them
+    public boolean isInHazardousWater() {
+        if (this.getInBlockState().is(Blocks.BUBBLE_COLUMN)) return true;
+        FluidState fluidState = this.level().getFluidState(this.blockPosition());
+        return fluidState.is(FluidTags.WATER) && !fluidState.isSource();
+    }
+    // Cartridge end
+
     public boolean isUnderWater() {
         return this.wasEyeInWater && this.isInWater();
     }
@@ -2215,11 +2223,41 @@ public abstract class Entity
         boolean inWater = this.fluidInteraction.isInFluid(FluidTags.WATER);
         boolean inLava = this.fluidInteraction.isInFluid(FluidTags.LAVA);
         if (inWater) {
-            this.resetFallDistance();
             if (!this.wasTouchingWater && !this.firstTick) {
                 this.doWaterSplashEffect();
             }
+
+            // Cartridge start - water surfaces act like ground: falling onto water hurts on first contact.
+            // Players and boats pay the accumulated fall once, boats propagate it to their passengers,
+            // other entities keep the vanilla reset
+            if (this instanceof ServerPlayer player) {
+                if (!this.wasTouchingWater && this.fallDistance > 0.0) {
+                    // A harmless splash keeps the fall instead of resetting it, so stacked water layers cannot chain safe drops.
+                    // After the first damaging splash the rest of the chain gets no safe fall distance
+                    if (player.calculateFallDamage(this.fallDistance, 1.0F) > 0) {
+                        player.damageCooldownTime = 0; // splashes in quick succession would otherwise only deal the difference to the last hit
+                        this.causeFallDamage(this.fallDistance, 1.0F, this.damageSources().fall());
+                        this.resetFallDistance();
+                        player.safeFallDistanceSpent = true;
+                    }
+                    player.waterFallChainY = this.getY();
+                }
+            } else if (this instanceof net.minecraft.world.entity.vehicle.boat.AbstractBoat) {
+                if (!this.wasTouchingWater && this.fallDistance > 0.0) {
+                    this.causeFallDamage(this.fallDistance, 1.0F, this.damageSources().fall());
+                    this.resetFallDistance();
+                }
+            } else {
+                this.resetFallDistance();
+            }
+            // Cartridge end
+        }
+
+        // Cartridge start - a water fall chain only ends by leaving the water above where it was entered, sinking out the bottom keeps it
+        if (!inWater && this instanceof ServerPlayer player && this.getY() >= player.waterFallChainY) {
+            this.resetFallDistance();
         }
+        // Cartridge end
 
         this.wasTouchingWater = inWater;
         if (this.isPushedByFluid()) {
@@ -4023,7 +4061,7 @@ public abstract class Entity
             entity.setDeltaMovement(movement.x, yd, movement.z);
         }
 
-        entity.resetFallDistance();
+        if (!(entity instanceof ServerPlayer)) entity.resetFallDistance(); // Cartridge - bubble columns no longer negate fall damage
     }
 
     // Paper start
@@ -4041,6 +4079,7 @@ public abstract class Entity
     }
 
     public void checkFallDistanceAccumulation() {
+        if (this instanceof ServerPlayer) return; // Cartridge - no elytras, and the clamp erased falls carried through water
         if (this.getDeltaMovement().y() > -0.5 && this.fallDistance > 1.0) {
             this.fallDistance = 1.0;
         }
diff --git a/net/minecraft/world/entity/LivingEntity.java b/net/minecraft/world/entity/LivingEntity.java
index 6561be9f79d8c852fb9fb104f7b060efa959cb5c..aa989bb022e66050136c55735eea209069e93b31 100644
--- a/net/minecraft/world/entity/LivingEntity.java
+++ b/net/minecraft/world/entity/LivingEntity.java
@@ -386,6 +386,7 @@ public abstract class LivingEntity extends Entity implements Attackable, Waypoin
 
     @Override
     protected void checkFallDamage(final double ya, final boolean onGround, final BlockState onState, final BlockPos pos) {
+        if (this instanceof ServerPlayer player) player.accumulateFallDistance(ya); // Cartridge - before the water check, so a splash charges this tick's drop too
         if (!this.isInWater()) {
             this.updateFluidInteraction();
         }
diff --git a/net/minecraft/world/entity/vehicle/boat/AbstractBoat.java b/net/minecraft/world/entity/vehicle/boat/AbstractBoat.java
index 6c9ec44a46b6f40a2b8b008cc50c0cafe5e909e6..5b6310e9ec87253ae87d59ee009dec3b526aeed1 100644
--- a/net/minecraft/world/entity/vehicle/boat/AbstractBoat.java
+++ b/net/minecraft/world/entity/vehicle/boat/AbstractBoat.java
@@ -803,11 +803,15 @@ public abstract class AbstractBoat extends VehicleEntity implements Leashable {
     protected void checkFallDamage(final double ya, final boolean onGround, final BlockState onState, final BlockPos pos) {
         this.lastYd = this.getDeltaMovement().y;
         if (!this.isPassenger()) {
-            if (onGround) {
+            // Cartridge start - landing on ground or water applies the fall to passengers, then
+            // resets so old falls cannot linger and taint later riders
+            if (onGround || this.isInWater()) {
+                if (this.fallDistance > 0.0) this.causeFallDamage(this.fallDistance, 1.0F, this.damageSources().fall());
                 this.resetFallDistance();
             } else if (!this.level().getFluidState(this.blockPosition().below()).is(FluidTags.WATER) && ya < 0.0) {
                 this.fallDistance -= (float)ya;
             }
+            // Cartridge end
         }
     }
 
