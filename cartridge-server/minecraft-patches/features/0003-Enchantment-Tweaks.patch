@@ -1173,7 +1173,7 @@ public record VanillaChestLoot(HolderLookup.Provider registries) implements Loot
                                         .withOneOf(
                                             HolderSet.direct(
                                                 enchantments.getOrThrow(Enchantments.SHARPNESS),
-                                                enchantments.getOrThrow(Enchantments.BANE_OF_ARTHROPODS),
+                                                //enchantments.getOrThrow(Enchantments.BANE_OF_ARTHROPODS), // Cartridge - tweak enchantments
