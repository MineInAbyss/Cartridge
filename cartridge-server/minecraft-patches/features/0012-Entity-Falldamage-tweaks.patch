--- a/net/minecraft/world/entity/Entity.java
+++ b/net/minecraft/world/entity/Entity.java
@@ -95,6 +95,7 @@ import net.minecraft.world.Nameable;
 import net.minecraft.world.attribute.EnvironmentAttributes;
 import net.minecraft.world.damagesource.DamageSource;
 import net.minecraft.world.damagesource.DamageSources;
+import net.minecraft.world.entity.ai.attributes.Attributes;
 import net.minecraft.world.entity.item.ItemEntity;
 import net.minecraft.world.entity.player.Player;
 import net.minecraft.world.entity.projectile.Projectile;
@@ -2145,13 +2146,14 @@ public abstract class Entity
         }
 
         this.propagateFallToPassengers(fallDistance, damageModifier, damageSource);
-        return false;
+        return true; // Cartridge
     }
 
     protected void propagateFallToPassengers(final double fallDistance, final float damageModifier, final DamageSource damageSource) {
         if (this.isVehicle()) {
             for (Entity passenger : this.getPassengers()) {
-                passenger.causeFallDamage(fallDistance, damageModifier, damageSource);
+                passenger.causeFallDamage(fallDistance + passenger.fallDistance, damageModifier, damageSource); // Cartridge - riders can carry a harmless fall from earlier splashes or seat swaps
+                passenger.resetFallDistance(); // Cartridge - the fall is charged here, don't charge it again when they land or dismount
             }
         }
     }
@@ -3474,10 +3476,25 @@ public abstract class Entity
                 return false;
             }
             // CraftBukkit end
+            // Cartridge start - swapping seats teleports instead of falling, so the drop between the seats has to be added by hand
+            if (this instanceof ServerPlayer && this.isPassenger()) {
+                double newSeatedY = entityToRide.getPassengerRidingPosition(this).y - this.getVehicleAttachmentPoint(entityToRide).y;
+                this.fallDistance += Math.max(0.0, this.getY() - newSeatedY);
+            }
+            // Cartridge end
             if (this.isPassenger()) {
                 this.stopRiding();
             }
 
+            // Cartridge start - pay any accumulated fall on mounting so it cannot be dodged or charged twice
+            if (this instanceof ServerPlayer player) {
+                // A harmless drop is kept while seated, so hopping down a tower of seats adds up like one fall
+                player.chargeChainedFall();
+            } else if (this.fallDistance > 0.0) {
+                this.causeFallDamage(this.fallDistance, 1.0f, this.damageSources().fall());
+                this.resetFallDistance();
+            }
+            // Cartridge end
             this.setPose(Pose.STANDING);
             this.vehicle = entityToRide;
             this.vehicle.addPassenger(this);
@@ -3494,9 +3511,12 @@ public abstract class Entity
         }
     }
 
+    // Cartridge start - Prevent entering vehicle when falling
     protected boolean canRide(final Entity vehicle) {
-        return !this.isShiftKeyDown() && this.boardingCooldown <= 0;
+        boolean isSafeFallDistance = (!(this instanceof net.minecraft.world.entity.LivingEntity livingEntity) || this.fallDistance < livingEntity.getAttributeValue(net.minecraft.world.entity.ai.attributes.Attributes.SAFE_FALL_DISTANCE));
+        return isSafeFallDistance && !this.isShiftKeyDown() && this.boardingCooldown <= 0;
     }
+    // Cartridge end - Prevent entering vehicle when falling
 
     public void ejectPassengers() {
         for (int i = this.passengers.size() - 1; i >= 0; i--) {
@@ -3521,6 +3541,7 @@ public abstract class Entity
             Entity oldVehicle = this.vehicle;
             this.vehicle = null;
             if (!oldVehicle.removePassenger(this, suppressCancellation)) this.vehicle = oldVehicle; // CraftBukkit // Paper - Force entity dismount during teleportation
+            if (this.vehicle == null) this.fallDistance = Math.max(this.fallDistance, oldVehicle.getRootVehicle().fallDistance); // Cartridge - riders don't fall themselves, so leaving a falling vehicle keeps its fall
             Entity.RemovalReason removalReason = this.getRemovalReason();
             if (removalReason == null || removalReason.shouldDestroy()) {
                 this.level().gameEvent(this, GameEvent.ENTITY_DISMOUNT, oldVehicle.position);
