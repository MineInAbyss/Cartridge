diff --git a/net/minecraft/core/RegistrySynchronization.java b/net/minecraft/core/RegistrySynchronization.java
index 3f713afa1677eadccca1a9dd14021d94412efeda..fdb9a8fefd5bf53970500a9672efe1bfae091261 100644
--- a/net/minecraft/core/RegistrySynchronization.java
+++ b/net/minecraft/core/RegistrySynchronization.java
@@ -48,7 +48,8 @@ public class RegistrySynchronization {
                     registry.listElements()
                         .forEach(
                             element -> {
-                                boolean canSkipContents = registry.registrationInfo(element.key())
+                                final T preview = registryData.key().equals(net.minecraft.core.registries.Registries.BIOME) ? (T) com.mineinabyss.cartridge.biome.BiomePreview.preview(element.key().identifier()) : null; // Cartridge - Custom biomes
+                                boolean canSkipContents = preview == null && registry.registrationInfo(element.key()) // Cartridge - Custom biomes
                                     .flatMap(RegistrationInfo::knownPackInfo)
                                     .filter(clientKnownPacks::contains)
                                     .isPresent();
@@ -57,7 +58,7 @@ public class RegistrySynchronization {
                                     contents = Optional.empty();
                                 } else {
                                     Tag encodedElement = registryData.elementCodec()
-                                        .encodeStart(ops, element.value())
+                                        .encodeStart(ops, preview != null ? preview : element.value()) // Cartridge - Custom biomes
                                         .getOrThrow(s -> new IllegalArgumentException("Failed to serialize " + element.key() + ": " + s));
                                     contents = Optional.of(encodedElement);
                                 }
diff --git a/net/minecraft/resources/ResourceManagerRegistryLoadTask.java b/net/minecraft/resources/ResourceManagerRegistryLoadTask.java
index 65830af7d88dfe4db7a20ead28aff8e06a319615..5081d29eab45ba08919e3559f597adaaeb0b46a1 100644
--- a/net/minecraft/resources/ResourceManagerRegistryLoadTask.java
+++ b/net/minecraft/resources/ResourceManagerRegistryLoadTask.java
@@ -48,6 +48,7 @@ public class ResourceManagerRegistryLoadTask<T> extends RegistryLoadTask<T> {
             .thenCompose(
                 registryResources -> {
                     RegistryOps<JsonElement> ops = RegistryOps.create(JsonOps.INSTANCE, context);
+                    final Map<Identifier, RegistryLoadTask.PendingRegistration<T>> cartridgeBiomes = this.registryKey().equals(net.minecraft.core.registries.Registries.BIOME) ? this.loadCartridgeBiomes(lister, registryResources, ops) : Map.of(); // Cartridge - Custom biomes
                     return ParallelMapTransform.schedule(
                         (Map<Identifier, Resource>)registryResources,
                         (resourceId, thunk) -> {
@@ -60,7 +61,12 @@ public class ResourceManagerRegistryLoadTask<T> extends RegistryLoadTask<T> {
                             );
                         },
                         executor
-                    );
+                    ).thenApply(loaded -> { // Cartridge start - Custom biomes
+                        if (cartridgeBiomes.isEmpty()) return loaded;
+                        final Map<Identifier, RegistryLoadTask.PendingRegistration<T>> merged = new java.util.HashMap<>(loaded);
+                        merged.putAll(cartridgeBiomes);
+                        return merged;
+                    }); // Cartridge end - Custom biomes
                 }
             )
             .thenAcceptAsync(
@@ -77,4 +83,39 @@ public class ResourceManagerRegistryLoadTask<T> extends RegistryLoadTask<T> {
                 executor
             );
     }
+
+    // Cartridge start - Custom biomes
+    // Keyed by resource file so overrides replace the data pack entry, and sent without a known pack so clients receive the changed data instead of their local copy
+    private Map<Identifier, RegistryLoadTask.PendingRegistration<T>> loadCartridgeBiomes(final FileToIdConverter lister, final Map<Identifier, Resource> resources, final RegistryOps<JsonElement> ops) {
+        final Map<Identifier, JsonElement> biomes;
+        try {
+            biomes = com.mineinabyss.cartridge.biome.CartridgeBiomes.resolve(id -> {
+                final Resource resource = resources.get(lister.idToFile(id));
+                if (resource == null) return null;
+                try (java.io.Reader reader = resource.openAsReader()) {
+                    return net.minecraft.util.StrictJsonParser.parse(reader);
+                } catch (final java.io.IOException e) {
+                    throw new java.io.UncheckedIOException(e);
+                }
+            });
+        } catch (final Exception e) {
+            final ResourceKey<T> key = ResourceKey.create(this.registryKey(), Identifier.fromNamespaceAndPath("cartridge", "biomes"));
+            return Map.of(lister.idToFile(key.identifier()), new RegistryLoadTask.PendingRegistration<>(key, com.mojang.datafixers.util.Either.right(new IllegalStateException("Failed to load Cartridge biomes", e)), new RegistrationInfo(Optional.empty(), Lifecycle.stable())));
+        }
+
+        final RegistrationInfo registrationInfo = new RegistrationInfo(Optional.empty(), Lifecycle.stable());
+        final Map<Identifier, RegistryLoadTask.PendingRegistration<T>> pending = new java.util.HashMap<>();
+        biomes.forEach((id, json) -> {
+            final ResourceKey<T> key = ResourceKey.create(this.registryKey(), id);
+            com.mojang.datafixers.util.Either<T, Exception> value;
+            try {
+                value = com.mojang.datafixers.util.Either.left(this.data.elementCodec().parse(ops, json).getOrThrow());
+            } catch (final Exception e) {
+                value = com.mojang.datafixers.util.Either.right(new IllegalStateException("Failed to parse Cartridge biome " + id, e));
+            }
+            pending.put(lister.idToFile(id), new RegistryLoadTask.PendingRegistration<>(key, value, registrationInfo));
+        });
+        return pending;
+    }
+    // Cartridge end - Custom biomes
 }
