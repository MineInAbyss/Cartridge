diff --git a/net/minecraft/world/entity/player/Player.java b/net/minecraft/world/entity/player/Player.java
index 4ba3fb85b0473b4e7aa237701034d25f84e955cd..197b7a8ecec3b646f142747cea912585f9bce260 100644
--- a/net/minecraft/world/entity/player/Player.java
+++ b/net/minecraft/world/entity/player/Player.java
@@ -797,6 +797,7 @@ public abstract class Player extends Avatar implements ContainerUser {
 
     @Override
     protected void hurtArmor(final DamageSource damageSource, final float damage) {
+        if (!this.isReducedByArmor(damageSource)) return; // Cartridge - flat armor reduction
         this.doHurtEquipment(damageSource, damage, EquipmentSlot.FEET, EquipmentSlot.LEGS, EquipmentSlot.CHEST, EquipmentSlot.HEAD);
     }
 
@@ -805,6 +806,46 @@ public abstract class Player extends Avatar implements ContainerUser {
         this.doHurtEquipment(damageSource, damage, EquipmentSlot.HEAD);
     }
 
+    // Cartridge start - flat armor reduction
+    private static final float MIN_ARMORED_DAMAGE = 1.0F;
+
+    @Override
+    protected float getDamageAfterArmorAbsorb(final DamageSource damageSource, final float damage) {
+        if (!this.isReducedByArmor(damageSource)) {
+            return damage;
+        }
+        return Math.max(damage - this.getEffectiveArmor(damageSource), Math.min(damage, MIN_ARMORED_DAMAGE));
+    }
+
+    private boolean isReducedByArmor(final DamageSource damageSource) {
+        return (damageSource.getEntity() != null || damageSource.getDirectEntity() != null) && !damageSource.is(DamageTypeTags.BYPASSES_ARMOR);
+    }
+
+    // Breach and other armor_effectiveness enchantments scale the armor points instead of the vanilla armor fraction
+    private float getEffectiveArmor(final DamageSource damageSource) {
+        float armor = this.getArmorValue();
+        ItemStack weapon = damageSource.getWeaponItem();
+        if (weapon != null && this.level() instanceof ServerLevel level) {
+            armor *= Mth.clamp(EnchantmentHelper.modifyArmorEffectiveness(level, weapon, this, damageSource, 1.0F), 0.0F, 1.0F);
+        }
+        return armor;
+    }
+
+    // An attacker landing only the minimum damage, such as a fist, must not grant i-frames against stronger attacks
+    @Override
+    protected boolean clearsDamageCooldown(final DamageSource source, final org.bukkit.event.entity.EntityDamageEvent event) {
+        if (!this.isReducedByArmor(source)) {
+            return false;
+        }
+        float armorInput = (float) (event.getDamage()
+            + event.getDamage(org.bukkit.event.entity.EntityDamageEvent.DamageModifier.INVULNERABILITY_REDUCTION)
+            + event.getDamage(org.bukkit.event.entity.EntityDamageEvent.DamageModifier.FREEZING)
+            + event.getDamage(org.bukkit.event.entity.EntityDamageEvent.DamageModifier.HARD_HAT)
+            + event.getDamage(org.bukkit.event.entity.EntityDamageEvent.DamageModifier.BLOCKING));
+        return armorInput > 0.0F && armorInput - this.getEffectiveArmor(source) <= MIN_ARMORED_DAMAGE;
+    }
+    // Cartridge end - flat armor reduction
+
     @Override
     // CraftBukkit start
     protected boolean actuallyHurt(final ServerLevel level, final DamageSource source, float dmg, org.bukkit.event.entity.EntityDamageEvent event) { // void -> boolean
