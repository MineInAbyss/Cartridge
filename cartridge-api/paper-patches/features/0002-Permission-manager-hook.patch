 import org.jetbrains.annotations.ApiStatus;
 import org.jspecify.annotations.Nullable;
 
@@ -161,4 +165,41 @@ public interface PermissionManager {
      */
     void clearPermissions();
 
+    /**
+     * Called whenever a Bukkit entity is created, so the returned permissible is in place before any permission check.
+     * For players the result must extend {@link org.bukkit.permissions.PermissibleBase}, anything else falls back to a plain one.
+     * Entities are created often, so other entities should share one permissible unless they need their own
+     */
+    @ApiStatus.Experimental
+    default Permissible createPermissible(ServerOperator operator) {
+        if (operator instanceof org.bukkit.entity.Player) return new org.bukkit.permissions.PermissibleBase(operator);
+        return SharedEntityPermissible.INSTANCE;
+    }
+
+    /**
+     * Looks up the permissions of a player that has no {@link org.bukkit.entity.Player} yet, such as during the configuration phase.
+     * The returned permissible must not be kept around, it is not updated when the player's permissions change
+     */
+    @ApiStatus.Experimental
+    default CompletableFuture<Optional<Permissible>> loadPlayerPermissible(UUID playerUuid) {
+        return CompletableFuture.completedFuture(Optional.empty());
+    }
+
+    @ApiStatus.Internal
+    final class SharedEntityPermissible {
+        // Lazy, since PermissibleBase calculates default permissions when it is constructed
+        private static final Permissible INSTANCE = new org.bukkit.permissions.PermissibleBase(new ServerOperator() {
+            @Override
+            public boolean isOp() {
+                return false;
+            }
+
+            @Override
+            public void setOp(final boolean value) {
+            }
+        });
+
+        private SharedEntityPermissible() {
+        }
+    }
 }
